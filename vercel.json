{
  "headers": [
    {
      "source": "/uv/uv.sw.js",
      "headers": [
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/uv/service/:path*", "destination": "/index.html" },
    { "source": "/service/:path*", "destination": "/index.html" }
  ]
}
